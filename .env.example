# ── Required ──────────────────────────────────────────────────────────
# Anthropic API key — used by the agent pipeline and GraphRAG LLM-as-judge.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Neo4j (defaults match docker-compose.yml) ─────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=infrawatch

# ── Prometheus (default matches docker-compose.yml) ───────────────────
PROMETHEUS_URL=http://localhost:9090

# ── Grafana (defaults match docker-compose.yml) ───────────────────────
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=infrawatch

# ── Ollama (optional — for local LLM inference) ───────────────────────
# No key needed. Requires `ollama serve` running on the default port.
# OLLAMA_HOST=http://localhost:11434

# ── Hosted demo: shared-password gate (optional) ──────────────────────
# When DEMO_PASSWORD is set, the frontend redirects all routes to /login
# until the visitor enters this password. Cookie persists for 12 h.
# SESSION_SECRET is REQUIRED whenever DEMO_PASSWORD is set — generate one
# with `openssl rand -hex 32`. Leave both unset for local dev to disable
# the gate entirely.
# DEMO_PASSWORD=infrawatch-pjatk-2026
# SESSION_SECRET=

# ── Hosted demo: Cloudflare Tunnel ────────────────────────────────────
# Cloudflared is installed directly on the host (no Docker), runs against
# the frontend container's exposed port (localhost:3001). One-time
# config + a launchd/systemd service. See docs/CLOUDFLARE_TUNNEL.md.
