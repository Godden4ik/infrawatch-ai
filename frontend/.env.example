ENCRYPTION_SECRET=change-me-in-production

# Shared-password gate for the demo deployment.
# When set, all routes redirect to /login unless the visitor presents a
# valid signed session cookie. Leave unset (or empty) in local dev to
# disable the gate entirely.
# Example: DEMO_PASSWORD=infrawatch-pjatk-2026
DEMO_PASSWORD=

# REQUIRED when DEMO_PASSWORD is set. HMAC key used to sign session
# tokens — the cookie never contains the password itself, just an
# opaque signed token. Must be ≥32 chars of cryptographically random
# input. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: external dashboard URLs surfaced by the header launcher strip.
# Defaults are localhost ports — override on production deployments.
# NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
# NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
# NEXT_PUBLIC_NEO4J_URL=http://localhost:7474
